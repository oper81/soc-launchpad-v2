<!--
  Локальные правила 100100-100140. Повторяют логику socsim/detect.py.
  Проверено: НЕТ. Проверка — wazuh-logtest, см. docs/lab-setup.md и
  wazuh/logtest/samples.txt. Поведение может отличаться от офлайн-детектора.
-->
<group name="socsim,">

  <!-- 100100: SSH brute force: >=5 Failed password с одного IP за 120с -->
  <rule id="100100" level="10" frequency="5" timeframe="120">
    <if_matched_sid>5710</if_matched_sid>
    <same_source_ip />
    <description>socsim: SSH brute force (5+ failed passwords / 120s)</description>
    <mitre>
      <id>T1110</id>
    </mitre>
  </rule>

  <!-- 100101: SSH compromise: Accepted с IP, который недавно брутфорсил -->
  <rule id="100101" level="12" frequency="1" timeframe="600">
    <if_sid>5715</if_sid>
    <if_matched_sid>100100</if_matched_sid>
    <same_source_ip />
    <description>socsim: SSH compromise after brute force</description>
    <mitre>
      <id>T1078</id>
    </mitre>
  </rule>

  <!-- 100110: Web exploitation: подозрительный path -->
  <rule id="100110" level="10">
    <if_group>web|accesslog</if_group>
    <url>/admin|/\.env|/\.\./\.\.|/shell\.php|/wp-login\.php</url>
    <description>socsim: suspicious web request path</description>
    <mitre>
      <id>T1190</id>
    </mitre>
  </rule>

  <!-- 100120: Port scan: >=15 DROP с одного IP за 60с -->
  <rule id="100120" level="10" frequency="15" timeframe="60">
    <if_group>firewall|iptables</if_group>
    <same_source_ip />
    <description>socsim: port scan detected (15+ DROPs / 60s)</description>
    <mitre>
      <id>T1046</id>
    </mitre>
  </rule>

  <!-- 100130: Exec from /tmp через auditd -->
  <rule id="100130" level="12">
    <decoded_as>auditd-exec-tmp</decoded_as>
    <description>socsim: execution from /tmp (auditd exec_tmp)</description>
    <mitre>
      <id>T1059</id>
    </mitre>
  </rule>

  <!-- 100140: Valid account after hours (00:00-06:00), частичное покрытие -->
  <rule id="100140" level="8">
    <if_sid>5715</if_sid>
    <time>00:00-06:00</time>
    <description>socsim: valid account login after hours</description>
    <mitre>
      <id>T1078</id>
    </mitre>
  </rule>

</group>